<!--
  @brief Панель отладочного журнала

  Содержит выпадающий список для выбора уровня логирования,
  кнопки очистки и сохранения журнала, а также текстовое поле
  для отображения сообщений.
-->
<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>dbg</class>
 <widget class="QWidget" name="dbg">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>783</width>
    <height>104</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>dbg</string>
  </property>
  <!--
    @brief Главный вертикальный layout с нулевыми отступами

    Располагает панель управления (уровень + кнопки) и текстовое поле лога.
  -->
  <layout class="QVBoxLayout" name="verticalLayout">
   <property name="leftMargin">
    <number>0</number>
   </property>
   <property name="topMargin">
    <number>0</number>
   </property>
   <property name="rightMargin">
    <number>0</number>
   </property>
   <property name="bottomMargin">
    <number>0</number>
   </property>
   <item>
    <!--
      @brief Горизонтальная панель управления журналом

      Содержит метку "Log level", выпадающий список фильтра,
      растягивающийся spacer, кнопки "Clear log" и "Save log".
    -->
    <layout class="QHBoxLayout" name="horizontalLayout">
     <item>
      <widget class="QLabel" name="label_5">
       <property name="text">
        <string>Log level</string>
       </property>
      </widget>
     </item>
     <item>
      <!--
        @brief Выпадающий список уровней логирования

        Заполняется программно в wdg_dbg_t::wdg_dbg_t():
        Warn, Status, Info, Debug, All.
      -->
      <widget class="QComboBox" name="cb_level"/>
     </item>
     <item>
      <!-- Растягивающийся spacer для выравнивания кнопок вправо -->
      <spacer name="horizontalSpacer">
       <property name="orientation">
        <enum>Qt::Horizontal</enum>
       </property>
       <property name="sizeHint" stdset="0">
        <size>
         <width>40</width>
         <height>20</height>
        </size>
       </property>
      </spacer>
     </item>
     <item>
      <!--
        @brief Кнопка очистки журнала

        Вызывает wdg_dbg_t::slt_btn_clr() — очищает содержимое log.
      -->
      <widget class="QPushButton" name="btn_clr">
       <property name="text">
        <string>Clear log</string>
       </property>
       <property name="icon">
        <iconset resource="../qccf.qrc">
         <normaloff>:/images/reset.png</normaloff>:/images/reset.png</iconset>
       </property>
      </widget>
     </item>
     <item>
      <!--
        @brief Кнопка сохранения журнала в файл

        Вызывает wdg_dbg_t::slt_btn_save() — открывает QFileDialog
        и записывает содержимое log в выбранный файл .txt.
      -->
      <widget class="QPushButton" name="btn_save">
       <property name="text">
        <string>Save log</string>
       </property>
       <property name="icon">
        <iconset resource="../qccf.qrc">
         <normaloff>:/images/log.png</normaloff>:/images/log.png</iconset>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <!--
      @brief Текстовое поле отладочного журнала

      QPlainTextEdit с минимальной высотой 64 пикселя.
      Отображает сообщения с временными метками и цветовой маркировкой.
    -->
    <widget class="QPlainTextEdit" name="log">
     <property name="minimumSize">
      <size>
       <width>0</width>
       <height>64</height>
      </size>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
 <resources>
  <include location="../qccf.qrc"/>
 </resources>
 <connections/>
</ui>
