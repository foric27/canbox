<!--
  @brief Файл ресурсов Qt (qcanbox.qrc)

  Включает PNG-иконки для элементов интерфейса эмулятора:
  - connect.png / disconnect.png — состояние COM-порта
  - about.png — кнопка "О программе"
  - fl_door.png, fr_door.png, rl_door.png, rr_door.png — двери
  - belt.png — ремень безопасности
  - bonnet.png — капот
  - tailgate.png — багажник
-->
<RCC>
    <qresource prefix="/">
	<file>images/connect.png</file>
	<file>images/disconnect.png</file>
	<file>images/about.png</file>

	<file>images/fl_door.png</file>
	<file>images/fr_door.png</file>
	<file>images/rl_door.png</file>
	<file>images/rr_door.png</file>
	<file>images/belt.png</file>
	<file>images/bonnet.png</file>
	<file>images/tailgate.png</file>
    </qresource>
</RCC>
