# Auto-detect text files, normalize to LF on commit
* text=auto

# Source code — LF line endings
*.c   text eol=lf
*.h   text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.S   text eol=lf
*.s   text eol=lf
*.ld  text eol=lf

# Build system — LF
Makefile       text eol=lf
Makefile_*     text eol=lf
Makefile.include text eol=lf
*.mk           text eol=lf
*.cfg text eol=lf

# Qt project
*.pro  text eol=lf
*.pri  text eol=lf
*.ui   text eol=lf

# Documentation
*.md   text eol=lf
*.txt  text eol=lf
*.diff text eol=lf

# Binary files
*.svg  text eol=lf
*.qrc  text eol=lf
*.json text eol=lf

# KiCad files (text, not binary)
*.sch text eol=lf
*.lib text eol=lf
*.dcm text eol=lf
*.net text eol=lf
*.kicad_pcb text eol=lf
*.kicad_sch text eol=lf

# Binary files
*.bin  binary
*.elf  binary
*.o    binary
*.vo   binary
*.vwo  binary
*.qemu binary
*.stm32f1 binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.exe  binary
*.dll  binary
